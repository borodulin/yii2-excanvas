{
    "name": "conquer/excanvas",
    "description": "ExplorerCanvas (HTML5 canvas for IE 8 and older) asset bundle for Yii2",
    "keywords": [
        "yii2",
        "extension",
        "asset",
        "excanvas",
        "canvas"
    ],
    "homepage": "https://github.com/borodulin/yii2-excanvas",
    "type": "yii2-extension",
    "license": "MIT AND Apache-2.0",
    "support": {
        "issues": "https://github.com/borodulin/yii2-excanvas/issues",
        "source": "https://github.com/borodulin/yii2-excanvas"
    },
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "conquer\\excanvas\\": ""
        }
    }
}
